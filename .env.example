# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Database credentials
DB_USER=itsnotesuser
DB_PASSWORD=change-this-password
DB_NAME=itsnotes

# Authentication — leave blank to have the server auto-generate one on first run.
# Set this only if you want to control the secret yourself (e.g. openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional: AI features
# OPENAI_API_KEY=sk-...

# Optional: empty-note cleanup (enabled by default — set to false to disable)
# Removes notes with no title, content, images, or attachments left behind by
# abandoned "+" clicks. The age guard skips notes touched recently.
# EMPTY_NOTE_CLEANUP_ENABLED=false
# EMPTY_NOTE_CLEANUP_AGE_MINUTES=1440
# EMPTY_NOTE_CLEANUP_CRON=0 3 * * *

# Optional: trash cleanup (enabled by default — set to false to disable)
# Permanently deletes notes that have sat in the trash past the retention window.
# TRASH_CLEANUP_ENABLED=false
# TRASH_CLEANUP_AGE_DAYS=30
# TRASH_CLEANUP_CRON=0 3 * * *

# Optional: auto-archive (disabled by default — set to true to enable)
# Archives notes that haven't been edited in the given number of days. Skips
# pinned and trashed notes; nothing is deleted. Configurable in Settings > Maintenance.
# AUTO_ARCHIVE_ENABLED=true
# AUTO_ARCHIVE_AGE_DAYS=365
# AUTO_ARCHIVE_CRON=0 3 * * *

# Optional: push notifications (any one or none)
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
# PUSHBULLET_TOKEN=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=

# Server — local development only (not used in Docker)
# Copy to .env and fill in your values.

PORT=5000

# Database (local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=itsnotesuser
DB_PASSWORD=itsnotespassword
DB_NAME=itsnotes

NODE_ENV=development

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: AI features
# OPENAI_API_KEY=sk-...

# Optional: Puppeteer (leave empty to use bundled Chromium)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Optional: push notifications (any one or none)
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
# PUSHBULLET_TOKEN=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=

# Optional: backup/restore via Docker CLI
# DOCKER_DB_CONTAINER=itsnotes-db
